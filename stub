# ---------------------------------------------------------------------------
# API client
# ---------------------------------------------------------------------------
class TMDBClient:
    """Thin wrapper around the TMDB v3 API. Every method returns (data, error)
    — error is None on success, or a short human-readable string on failure.
    Nothing here ever raises; the UI layer never needs to catch anything."""
    def __init__(self):
        self.session = requests.Session()
        self.session.headers.update(HEADERS)

    def _get_json(self, url, params=None):
        try:
            resp = self.session.get(url, params=params, timeout=10)
        except requests.exceptions.Timeout:
            return None, "Request timed out."
        except requests.exceptions.RequestException as e:
            return None, f"Network error: {e}"
        if resp.status_code != 200:
            return None, f"HTTP {resp.status_code}"
        try:
            return resp.json(), None
        except ValueError:
            return None, "Malformed JSON response."

    def search_multi(self, title: str, year: str = ""):
        """Searches movies AND tv shows in one call via TMDB's multi-search.
        Filters out 'person' results and keeps each item's media_type."""
        data, err = self._get_json(f"{TMDB_BASE_URL}/search/multi", params={"query": title})
        if err:
            return [], err
        results = [r for r in data.get("results", []) if r.get("media_type") in ("movie", "tv")]
        if year:
            def year_of(r):
                date = r.get("release_date") or r.get("first_air_date") or ""
                return date[:4]
            results = [r for r in results if year_of(r) == year]
        return results, None

    def get_by_id(self, media_type: str, tmdb_id):
        endpoint = "movie" if media_type == "movie" else "tv"
        return self._get_json(f"{TMDB_BASE_URL}/{endpoint}/{tmdb_id}")

    def get_season(self, tv_id, season_number):
        return self._get_json(f"{TMDB_BASE_URL}/tv/{tv_id}/season/{season_number}")


def safe_addstr(win, y, x, text, attr=0):
    """Never lets a curses write outside the window crash the app —
    truncates to the available width and swallows the edge-case curses.error
    that happens when writing to the exact bottom-right cell."""
    h, w = win.getmaxyx()
    if 0 <= y < h and 0 <= x < w:
        try:
            win.addstr(y, x, text[: max(0, w - x - 1)], attr)
        except curses.error:
            pass


